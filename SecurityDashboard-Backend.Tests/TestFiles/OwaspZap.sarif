                        "text": "Private IP Disclosure"
                     }
                  },
                  {
                     "id": "3",
                     "defaultConfiguration": {
                        "level": "warning"
                     },
                     "fullDescription": {
                        "text": "URL rewrite is used to track user session ID. The session ID may be disclosed via cross-site referer header. In addition, the session ID might be stored in browser history or server logs."
                     },
                     "name": "Session ID in URL Rewrite",
                     "properties": {
                            "references": [
                                "https:\/\/seclists.org\/webappsec\/2002\/q4\/111"
                            ],
                            "solution": {
                                "text": "For secure content, put session ID in a cookie. To be even more secure consider using a combination of cookie and URL rewrite."
                            },
                            "confidence": "high"
                     },
                     "relationships": [ 
                        {
                           "kinds": [
                              "superset"
                           ],
                           "target": {
