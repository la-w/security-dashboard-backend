{
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skims",
          "contents": [
            "localizedData",
            "nonLocalizedData"
          ],
          "rules": [
            {
              "id": "165",
              "fullDescription": {
                "text": "Because of a misconfiguration in the AWS services, it is possible to identify and/or try to access resources, functionalities, network segments and ports.\n"
              },
              "help": {
                "text": "Securely configure the vulnerable service to be accessed only by authorized users.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/165#details",
              "name": "Insecure service configuration - AWS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "182",
              "fullDescription": {
                "text": "The absence of DMARC records could allow spoofing of the email domain.\n"
              },
              "help": {
                "text": "Configure a DMARC record with policies suitable for the domain.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/182#details",
              "name": "Email spoofing",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "431",
              "fullDescription": {
                "text": "A lock file has not been defined to validate the integrity of the software to be used. This can lead to a supply chain attack if the software is compromised, such as by injecting malware.\n"
              },
              "help": {
                "text": "Set the version numbers in your administrator file and make use of the lock file where the complete software tree used by the project is defined and where it has integrity data defined for each software used.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/431#details",
              "name": "Supply Chain Attack - Lock Files",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "143",
              "fullDescription": {
                "text": "The eval function is used with the input of request data, such as url params or request headers, this data is not properly validated and can lead to statements being injected to execute commands on the server.\n"
              },
              "help": {
                "text": "Perform validations over user data entry.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/143#details",
              "name": "Inappropriate coding practices - Eval function",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "011",
              "fullDescription": {
                "text": "The system uses the version of a software or dependency with known vulnerabilities.\n"
              },
              "help": {
                "text": "Update the affected software to the versions recommended by the vendor.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/011#details",
              "name": "Use of software with known vulnerabilities",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "130",
              "fullDescription": {
                "text": "The system does not set the Secure attribute for sensitive cookies, which could cause them to be sent through an insecure channel.\n"
              },
              "help": {
                "text": "The application must set the Secure attribute in the cookies with sensitive information.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/130#details",
              "name": "Insecurely generated cookies - Secure",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "091",
              "fullDescription": {
                "text": "The system logs entries that contain input from untrusted sources without properly validating, sanitizing or escaping their content.\n"
              },
              "help": {
                "text": "Sanitize inputs before storing them in the log.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/091#details",
              "name": "Log injection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "149",
              "fullDescription": {
                "text": "The configuration of the SMTP service is set to not use SSL, so confidential information traveling by this means that can be viewed without any type of encryption.\n"
              },
              "help": {
                "text": "Deploy the application over an encrypted communication channel, use SSL secure protocols.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/149#details",
              "name": "Use of an insecure channel - SMTP",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "012",
              "fullDescription": {
                "text": "Dynamic SQL statements are generated without the required data validation and without using parameterized statements or stored procedures. When using LIKE-conditions with values that are coming from a not secure source in the Java Persistence API, the values should be sanitized so they can't contain any wildcards and thereby allow attackers to select more data than they should be able to. For this purpose the escape(String) method is available.\n"
              },
              "help": {
                "text": "Perform queries to the database through sentences or parameterized procedures. Alternatively use escape(String) built-in function.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/012#details",
              "name": "SQL injection - Java Persistence API",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "156",
              "fullDescription": {
                "text": "Redirects made by the application are not controlled and could be manipulated by an attacker.\n"
              },
              "help": {
                "text": "Use predefined parameters and not information that can be manipulated by the user for redirection to web sites in the application.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/156#details",
              "name": "Uncontrolled external site redirect",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "414",
              "fullDescription": {
                "text": "The application disables the HeaderChecking property, which enables the encoding of newlines and carriage returns, thus allowing the injection of malicious headers\n"
              },
              "help": {
                "text": "Set the EnableHeaderChecking property to true, of remove the line that sets the property in false, since its default value is true\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/414#details",
              "name": "Insecure service configuration - Header Checking",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "258",
              "fullDescription": {
                "text": "The current configuration of Elastic Load Balancing has no Deletion Protection safety feature enabled.\n"
              },
              "help": {
                "text": "Check the Deletion Protection configuration attribute value inside attributes section and enable it.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/258#details",
              "name": "Lack of protection against deletion - ELB",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "353",
              "fullDescription": {
                "text": "The generated JWT access token does not validate if the signature is valid so the token can be modified and requests are accepted; even removing the signature from the token works.\n"
              },
              "help": {
                "text": "Generate a token with random components without sensitive information and always validate that the integrity of the token is maintained (signature verification, signature).\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/353#details",
              "name": "Lack of data validation - Token",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "266",
              "fullDescription": {
                "text": "The containers executed in the application do not properly restrict the privileges of the users, executing tasks with root user instead of a custom user.\n"
              },
              "help": {
                "text": "- Restrict the privileges of the user that execute instructions inside the container.\n- Avoid the use of the root user as default user.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/266#details",
              "name": "Excessive Privileges - Docker",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "063",
              "fullDescription": {
                "text": "The software uses external input to construct a pathname that is intended to identify a file or directory but it does not properly neutralize or validate special elements within the pathname.\n"
              },
              "help": {
                "text": "- Prevent the attacker from constructing the pathname.\n- Validate/Neutralize the input for special elements like: .., ~, /.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/063#details",
              "name": "Lack of data validation - Path Traversal",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "343",
              "fullDescription": {
                "text": "The site meets the conditions that make it potentially vulnerable to BREACH attacks:\n- Uses HTTP gzip compression.\n- The information entered by the user is reflected on the site.\n- It stores secrets (session tokens or anti-CSRF).\n"
              },
              "help": {
                "text": "Securely configure the vulnerable service so that it can only be accessed by authorized users.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/343#details",
              "name": "Insecure service configuration - BREACH Attack",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "368",
              "fullDescription": {
                "text": "The JSch StrictHostKeyChecking configuration is set to no, this indicates that connections may be made to unknown servers or servers that have changed their keys, generating new ones and adding them by default to the known server files.\n"
              },
              "help": {
                "text": "- Limit access to administrative services such as SSH.\n- Implement safe values for StricktHostKeyChecking configuration.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/368#details",
              "name": "Unrestricted access between network segments - StrictHostKeyChecking",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "239",
              "fullDescription": {
                "text": "It is possible to cause the server to throw errors after analyzing the endpoints with different techniques such as: sending massive requests to the endpoint, sending massive characters in the body of the application.\n"
              },
              "help": {
                "text": "Use generic messages to indicate server errors and avoid sending technical information.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/239#details",
              "name": "Technical information leak - Errors",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "075",
              "fullDescription": {
                "text": "The Content Provider API allows third party applications installed in the device to retrieve data stored by the application. Access to this data must not be allowed to all applications by default. Instead, (and only if required) specific allow-lists must be used.\n"
              },
              "help": {
                "text": "- Deny access to all Content Providers with: android:exported=false and android:grantUriPermissions=false. If required you can allow specific Content Providers by using grant-uri-permission. - If the attribute android:grantUriPermissions=true is required, establish a custom permission using the permission tag with a Signature protection level.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/075#details",
              "name": "Unauthorized access to files - APK Content Provider",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "058",
              "fullDescription": {
                "text": "The system has debugging enabled in the production environment, which can cause technical information leaks when an error occurs.\n"
              },
              "help": {
                "text": "Configure the attribute: application.android:debuggable to false in the file: AndroidManifest.xml.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/058#details",
              "name": "Debugging enabled in production - APK",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "338",
              "fullDescription": {
                "text": "Salt is generated in an insecure way, which makes the password easier to guess.\n"
              },
              "help": {
                "text": "Generate the Salt with a secure hashing function.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/338#details",
              "name": "Insecure service configuration - Salt",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "107",
              "fullDescription": {
                "text": "The system builds LDAP queries using untrusted data that could modify the query.\n"
              },
              "help": {
                "text": "- Avoid using untrusted data to generate dynamic LDAP queries.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/107#details",
              "name": "LDAP injection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "109",
              "fullDescription": {
                "text": "Some RDS Cluster or Instances are not defined inside a Database Subnet Group.\n"
              },
              "help": {
                "text": "Ensure that all RDS instances belong to a Database Subnet Group.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/109#details",
              "name": "Unrestricted access between network segments - RDS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "148",
              "fullDescription": {
                "text": "Customer information is transmitted over a channel that does not use encryption, so credentials and confidential information can be captured in plain text.\n"
              },
              "help": {
                "text": "Deploy the application over an encrypted communication channel, such as SFTP.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/148#details",
              "name": "Use of an insecure channel - FTP",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "246",
              "fullDescription": {
                "text": "The application stores information from user queries within the database that is stored on the device, allowing an attacker to access the information.\n"
              },
              "help": {
                "text": "Encrypt all sensitive information that is transported or stored within the application according to the organizations policies.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/246#details",
              "name": "Non-encrypted confidential information - DB",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "089",
              "fullDescription": {
                "text": "The system mixes trusted and untrusted data in the same data structure or structured message.\n"
              },
              "help": {
                "text": "- Prevent the use of untrusted data in critical data structures or structured messages.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/089#details",
              "name": "Lack of data validation - Trust boundary violation",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "134",
              "fullDescription": {
                "text": "The cross-domain policy includes wildcards, accepting any domain as valid for sharing resources.\n"
              },
              "help": {
                "text": "Remove the wildcard (*) and define explicitly the trusted origins for the application resources.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/134#details",
              "name": "Insecure or unset HTTP headers - CORS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "408",
              "fullDescription": {
                "text": "Some AWS API Gateway instances do not enable the logging feature, discarding information that can be managed by other AWS services such as Cloudwatch to detect possible system anomalies\n"
              },
              "help": {
                "text": "- Enable the logging feature for all the API gateway instances\n- Set a destination for the log files using other log services such as CloudWatch or Cloudtrail\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/408#details",
              "name": "Traceability Loss - API Gateway",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "177",
              "fullDescription": {
                "text": "EC2 Security Groups are not explicitly defined. Security Group input/output rules are not defined.\n"
              },
              "help": {
                "text": "Securely configure the vulnerable service by explicitly defining the Security Groups.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/177#details",
              "name": "Insecure service configuration - Security Groups",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "398",
              "fullDescription": {
                "text": "The application is vulnerable to Fragment Injection caused either by an unsafe implementation of PreferenceActivity or an insecure configuration of isValidFragment.\n"
              },
              "help": {
                "text": "- Set the attribute exported to false to avoid the attempt of foreign applications to exploit the vulnerability.\n- Ensure the application is running with targetSdkVersion higher than 19.\n- Set a whitelist of trusted fragments and validate them through the implementation of isValidFragment.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/398#details",
              "name": "Fragment Injection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "394",
              "fullDescription": {
                "text": "One or more Cloudtrail instances do not enable the EnableLogFileValidation attribute avoiding the integrity validation to be performed. This practice could aid an attacker to inject malicious information in log files without raising any alert.\n"
              },
              "help": {
                "text": "Set the EnableLogFileValidation attribute in true for all Cloudtrail instances.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/394#details",
              "name": "Insufficient data authenticity validation - Cloudtrail Logs",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "029",
              "fullDescription": {
                "text": "The system does not perform an adequate control of the size of the files that can be uploaded to the server.\n"
              },
              "help": {
                "text": "Implement controls to limit the maximum file size that can be uploaded to the server.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/029#details",
              "name": "Inadequate file size control",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "235",
              "fullDescription": {
                "text": "It is possible to obtain technical information such as technology names or component versions through the server response headers.\n"
              },
              "help": {
                "text": "Verify that HTTP response headers do not contain any name or version.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/235#details",
              "name": "Technical information leak - Headers",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "256",
              "fullDescription": {
                "text": "The current configuration has no protection against deletion, this can lead to the deletion of databases in Amazon Web Services RDS.\n"
              },
              "help": {
                "text": "Securely configure the Amazon Web Services service, allowing protection against accidental deletion.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/256#details",
              "name": "Lack of protection against deletion - RDS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "203",
              "fullDescription": {
                "text": "Some cloud storage service used by the application can be publicly accessed, without requiring any authentication, allowing an attacker to download its content, modify or delete the stored information\n"
              },
              "help": {
                "text": "Restrict the access of the public storage services of the system\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/203#details",
              "name": "Unauthorized access to files - Cloud Storage Services",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "325",
              "fullDescription": {
                "text": "- Privileges are granted with wildcard (*) in critical actions.\n- Many roles have unnecessary privileges over IAM.\n- Some write actions allow the use of Wildcards(*).\n"
              },
              "help": {
                "text": "Grant privileges strictly to the roles that need it.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/325#details",
              "name": "Excessive privileges - Wildcards",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "259",
              "fullDescription": {
                "text": "The current configuration has no protection against deletion (recovery points in time). The deletion of DynamoDB instances deletes the information without the possibility of recovery.\n"
              },
              "help": {
                "text": "Securely configure the Amazon Web Services service, enabling protection against accidental deletion with recovery points in time.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/259#details",
              "name": "Lack of protection against deletion - DynamoDB",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "112",
              "fullDescription": {
                "text": "Dynamic SQL statements are generated without the required data validation and without using parameterized statements or stored procedures.\n"
              },
              "help": {
                "text": "Perform queries to the database through sentences or parameterized procedures. Alternatively, use escape(String) built-in function.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/112#details",
              "name": "SQL injection - Java SQL API",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "073",
              "fullDescription": {
                "text": "Some RDS instances can be publicly accessible, which can compromise the stored information.\n"
              },
              "help": {
                "text": "Ensure that the relational databases are accesible only by users and roles authenticated and authorized.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/073#details",
              "name": "Improper authorization control for web services - RDS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "426",
              "fullDescription": {
                "text": "Kubernetes dependencies are not pinned to an exact digest, making the docker build unable the verify the integrity of the image and allowing a malicious actor to override the used components with malicious components without leaving a trace.\n"
              },
              "help": {
                "text": "Use mechanisms such as git-commits, or artifacts and hashes to verify the data integrity.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/426#details",
              "name": "Supply Chain Attack - Kubernetes",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "009",
              "fullDescription": {
                "text": "The source code repository contains sensitive information such as usernames, passwords, email addresses and IP addresses, among others. Alternatively, while values may be password=123 o aws.secret_key=test, they reveal the bad practice of storing sensitive information in the repository with no encryption, and sooner or later they can be replaced for real sensitive values.\n"
              },
              "help": {
                "text": "- Delete all hardcoded sensitive information.\n- Change all affected access credentials.\n- Remove sensitive information from git logs.\n- Load sensitive data from safe sources such as, key vault services, configuration files properly encrypted or administrative environment variables.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/009#details",
              "name": "Sensitive information in source code",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "081",
              "fullDescription": {
                "text": "Critical services of the system, such as databases, shared resources containing sensitive information and web services, are not protected by a multi-factor authentication mechanism. This makes it easier for an attacker who has compromised a user's account to access those resources.\n"
              },
              "help": {
                "text": "Implement a double factor authentication by software or hardware to increase the protection level of the resources authentication.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/081#details",
              "name": "Lack of multi-factor authentication",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "395",
              "fullDescription": {
                "text": "The application uses static, hardcoded values for initialization vectors. By knowing initialization vectors an attacker could perform a reverse engineering attack to predict the random values that should remain as secrets.\n"
              },
              "help": {
                "text": "Generate initialization vectors randomly using mechanisms with secure randomness and high entropy.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/395#details",
              "name": "Insecure generation of random numbers -  Static IV",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "042",
              "fullDescription": {
                "text": "The system does not set security attributes for sensitive cookies, which could cause them to be sent in plain text or disclosed by unauthorized users on the client side.\n"
              },
              "help": {
                "text": "The application must set the corresponding security attributes when cookies are generated.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/042#details",
              "name": "Insecurely generated cookies",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "433",
              "fullDescription": {
                "text": "Some AWS Redshift cluster are not encrypted.\n"
              },
              "help": {
                "text": "Enable the redshift encryption for all clusters\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/433#details",
              "name": "Non-encrypted confidential information - Redshift Cluster",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "083",
              "fullDescription": {
                "text": "It is possible to inject XML code into the application's requests, which is then interpreted by the server. This could allow an attacker to perform data exfiltration or execute commands remotely.\n"
              },
              "help": {
                "text": "Filter the information that is received and sent by the application through white lists.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/083#details",
              "name": "XML injection (XXE)",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "362",
              "fullDescription": {
                "text": "It is possible to obtain technical information such as:\n- System component versions (HTTP headers, service banner, etc.)\n- Specific information about the configuration of server components (php.ini, web.config)\n"
              },
              "help": {
                "text": "Remove web services and files that exposes technical information.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/362#details",
              "name": "Technical information leak - Content response",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "065",
              "fullDescription": {
                "text": "The application does not disable caching of input fields, thus the information will be stored in the browser's cache.\n"
              },
              "help": {
                "text": "The data cache to browsers level must be disabled using some of these methods:\n- Use HTTP control headers that prevent cache.\n- Use meta-tags in HTML pages.\n- Disable the autocomplete field to prevent cache to fields level.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/065#details",
              "name": "Cached form fields",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "257",
              "fullDescription": {
                "text": "Instances do not have the termination/removal protection option enabled.\n"
              },
              "help": {
                "text": "Ensure that instances have Termination Protection safety feature enabled.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/257#details",
              "name": "Lack of protection against deletion - EC2",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "096",
              "fullDescription": {
                "text": "The system deserializes objects without first validating their content nor casting them to a specific type.\n"
              },
              "help": {
                "text": "Validate the incoming serialized objects and only deserialize them if they meet expected properties.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/096#details",
              "name": "Insecure deserialization",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "319",
              "fullDescription": {
                "text": "The definition of roles does not correctly represent the different aspects of responsibilities for the security levels of the organization.\n"
              },
              "help": {
                "text": "Verify the configured roles and be aware of the information that is transmitted about roles, accounts and logical groups in an application.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/319#details",
              "name": "Insecure service configuration - Roles",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "416",
              "fullDescription": {
                "text": "The application does not properly validate user input, allowing XamlReader instances to be manipulated to generate malicious elements that can interact with other system actors\n"
              },
              "help": {
                "text": "Define length and content validations in all the system inputs\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/416#details",
              "name": "XAML injection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "070",
              "fullDescription": {
                "text": "A misconfiguration or default setting on Elastic Load Balancers that can cause to unintentionally increase the attack surface of the company cloud infrastructure.\n"
              },
              "help": {
                "text": "- Application load balancers should use acceptable policies.\n- Create a custom ELB SSL security policy that contains secure ciphers.\n- Strongly advised that the load balancer uses a secure listener.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/070#details",
              "name": "Insecure service configuration - ELB",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "437",
              "fullDescription": {
                "text": "In the Git Hub actions if they do not have their actions locked for a specific revision, if a malicious change is made to a third party action, this change will be included in the next build that is run for any project that uses that action.\n"
              },
              "help": {
                "text": "Use mechanisms such as git-commits, or artifacts and hashes to verify the data integrity.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/437#details",
              "name": "Supply Chain Attack - GitHub Actions",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "346",
              "fullDescription": {
                "text": "The application defines unnecessary permissions that can be abused by an attacker to perform unauthorized read or write operations in the device.\n"
              },
              "help": {
                "text": "Disable unnecessary permissions, complying with the principle of least privilege\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/346#details",
              "name": "Excessive privileges - Mobile App",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "211",
              "fullDescription": {
                "text": "Within the source code there is evidence of the use of dangerous regular expressions, because they make use of complex operations to find matches, which can lead to an attacker sending a specific string of data that could cause the server to crash when evaluating the string with the dangerous regular expression.\n"
              },
              "help": {
                "text": "Use optimized regular expressions to perform functions without much computational overhead.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/211#details",
              "name": "Asymmetric denial of service - ReDoS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "082",
              "fullDescription": {
                "text": "It is possible to retrieve deleted files with sensitive information because they were merely sent to the Recycle Bin or removed using insecure protocols.\n"
              },
              "help": {
                "text": "Good practices must be followed to clean, delete, and destruction of sensitive information (Policies).\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/082#details",
              "name": "Insecurely deleted files",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "135",
              "fullDescription": {
                "text": "The application uses the X-XSS Protection header considered deprecated. The use of this header may lead to stored XSS vulnerabilities.\n"
              },
              "help": {
                "text": "Disable the X-XSS Protection filter in the server responses. Instead, define security policies using CSP Header.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/135#details",
              "name": "Insecure or unset HTTP headers - X-XSS Protection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "001",
              "fullDescription": {
                "text": "Dynamic SQL statements are generated without the required data validation and without using parameterized statements or stored procedures.\n"
              },
              "help": {
                "text": "Perform queries to the database through sentences or parameterized procedures.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/001#details",
              "name": "SQL injection - C Sharp SQL API",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "347",
              "fullDescription": {
                "text": "One of the activities in the application manifest is configured with launchMode=singleTask, this configuration is insecure because it opens the possibility that the application is vulnerable to Task Hijacking.\n"
              },
              "help": {
                "text": "Configure the launchMode with the singleInstance option.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/347#details",
              "name": "Insecure service configuration - Task Hijacking",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "372",
              "fullDescription": {
                "text": "Client information is transmitted over port 80 or HTTP, a channel that does not use encryption, so credentials and confidential information can be captured in plain text.\n"
              },
              "help": {
                "text": "Deploy the application over the HTTPS secure channel using TLS.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/372#details",
              "name": "Use of an insecure channel - HTTP",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "101",
              "fullDescription": {
                "text": "The system does not prevent critical objects from being deleted accidentally.\n"
              },
              "help": {
                "text": "Set up automatic backup or deletion protection for all storage services with important information.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/101#details",
              "name": "Lack of protection against deletion",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "085",
              "fullDescription": {
                "text": "The application stores sensitive information in the client-side storage (localStorage or sessionStorage). This exposes the information to unauthorized read operations.\n"
              },
              "help": {
                "text": "Do not use the client side storage to store sensitive information, use cookies instead by defining their respective security attributes.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/085#details",
              "name": "Sensitive data stored in client-side storage",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "008",
              "fullDescription": {
                "text": "The web application dynamically generates web content without validating the source of the potentially untrusted data.\n"
              },
              "help": {
                "text": "Perform input data validations on the server-side to avoid common script injection attacks.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/008#details",
              "name": "Reflected cross-site scripting (XSS)",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "086",
              "fullDescription": {
                "text": "The application does not properly check the integrity of resources loaded from third-party servers.\n"
              },
              "help": {
                "text": "Add the integrity attribute to HTML script tags.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/086#details",
              "name": "Missing subresource integrity check",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "136",
              "fullDescription": {
                "text": "The application lacks the Cache Control security header or sets the header in a insecure value.\n"
              },
              "help": {
                "text": "Set the Cache Control header in the server responses using a secure value such as no-store , no-cache and must-revalidate.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/136#details",
              "name": "Insecure or unset HTTP headers - Cache Control",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "333",
              "fullDescription": {
                "text": "Some EC2 instances have insecure configurations that an attacker can use to access or interrupt critical application processes\n"
              },
              "help": {
                "text": "Perform a hardening process over all the EC2 instances, by following the recommended best practices\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/333#details",
              "name": "Insecure service configuration - EC2",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "393",
              "fullDescription": {
                "text": "The system uses the version of a software or dependency with known vulnerabilities in pre-productive environments.\n"
              },
              "help": {
                "text": "- Update the affected software to the versions recommended by the vendor.\n- Replace deprecated components or components with Zero-Day vulnerabilities.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/393#details",
              "name": "Use of software with known vulnerabilities in development",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "413",
              "fullDescription": {
                "text": "The application does not properly validate the DLL files, allowing the injection of malicious DLLS\n"
              },
              "help": {
                "text": "- Verify with an antivirus that the imported DLLs do not contain virus, backdoors or potentially harmful information\n- Define a white-list of allowed DLLs and their respective integrity hashes\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/413#details",
              "name": "Insecure file upload - DLL Injection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "427",
              "fullDescription": {
                "text": "The EXPOSE instruction informs Docker that the container listens on the specified network ports at runtime. Inform only the ports that your application needs and avoid exposing ports such as HTTP (80).\n"
              },
              "help": {
                "text": "Deploy the application over an encrypted communication channel, for instance, HTTPS with TLS.\nAlways try to reduce the attack surface and use EXPOSE to mark and document only the required ports in the Dockerfile.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/427#details",
              "name": "Use of an insecure channel - Docker",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "160",
              "fullDescription": {
                "text": "The application creates temporary withouth properly restricting their privileges or access modes, allowing an attacker to craft new attack vectors\n"
              },
              "help": {
                "text": "Create the temporary files in a different directory than the default provided by the Operative system and ensure it has 0600 permission mask.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/160#details",
              "name": "Excessive privileges - Temporary Files",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "043",
              "fullDescription": {
                "text": "The application has unsafe configurations regarding the Content-Security-Policy header. This may be because:\n- Header is missing from server responses.\n- The header has not defined mandatory security policies.\n- Defined security policies contain insecure values.\n"
              },
              "help": {
                "text": "Set the Content-Security-Policy header in the server responses and configure it in a secure way.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/043#details",
              "name": "Insecure or unset HTTP headers - Content-Security-Policy",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "132",
              "fullDescription": {
                "text": "The server is missing the X-Content-Type-Options HTTP header.\n"
              },
              "help": {
                "text": "Set the X-Content-Type-Options header to nosniff in the server responses.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/132#details",
              "name": "Insecure or unset HTTP headers - X-Content-Type-Options",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "440",
              "fullDescription": {
                "text": "The application does not control browser functions in a document or within any iframe.\n"
              },
              "help": {
                "text": "- Enable the header permission policy and disable all functions that your application does not need.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/440#details",
              "name": "Insecure or unset HTTP headers - Permissions-Policy",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "359",
              "fullDescription": {
                "text": "The repository stores sensitive information such as users, passwords, emails, API credentials, among others.\n"
              },
              "help": {
                "text": "- Remove the hardcoded sensitive information and purge git logs\n- Change login credentials that were compromised.\n- Load sensitive data from secure sources such as key vault, encrypted configuration files or environment variables.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/359#details",
              "name": "Sensitive information in source code - Credentials",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "023",
              "fullDescription": {
                "text": "The server processes requests with the Host header set and redirects clients to any destination.\n"
              },
              "help": {
                "text": "Configure server to prevent third party hosts redirection.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/023#details",
              "name": "Uncontrolled external site redirect - Host Header Injection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "264",
              "fullDescription": {
                "text": "The server where the application is stored supports insecurely configured ciphers, in addition to the ECB mode considered insecure:\n- Data Encryption Standard (DES).\n"
              },
              "help": {
                "text": "Use a secure encryption algorithm.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/264#details",
              "name": "Insecure encryption algorithm - TripleDES",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "300",
              "fullDescription": {
                "text": "The system has flaws over authentication mechanisms or had been configured with one that can be bypassed.\n"
              },
              "help": {
                "text": "- Force users to register multiple authentication methods.\n- Enable Azure Fraud alert to empower users to proactively report attempts of someone trying to use their account.\n- Set account lockout thresholds notifications.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/300#details",
              "name": "Authentication mechanism absence or evasion - Azure",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "268",
              "fullDescription": {
                "text": "The application enables the use of JavaScript through the method setJavaScriptEnabled which is disabled by default. This practice increases the chances for an attacker to exploit XSS vulnerabilities.\n"
              },
              "help": {
                "text": "- Unless required otherwise the application must not allow the use of JavaScript.\n- If the use of JavaScript is enabled, implement content and length validations in all the input fields.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/268#details",
              "name": "Insecure service configuration - Webview",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "060",
              "fullDescription": {
                "text": "The system does not properly restrict incoming connections from unknown external hosts.\n"
              },
              "help": {
                "text": "Validate that incoming connections come from trusted hosts already defined in the known_hosts file.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/060#details",
              "name": "Insecure service configuration - Host verification",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "250",
              "fullDescription": {
                "text": "Disk or hard drives without encryption, leave data stored on a computer or network storage system unprotected. Full disk encryption is a great way to protect sensitive customer data.\n"
              },
              "help": {
                "text": "Set the encrypted property for all the hard drives instances defined as code.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/250#details",
              "name": "Non-encrypted hard drives",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "064",
              "fullDescription": {
                "text": "The systems internal clock is not synced with NTP servers.\n"
              },
              "help": {
                "text": "Sync the server date with a NTP server.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/064#details",
              "name": "Traceability loss - Server's clock",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "021",
              "fullDescription": {
                "text": "Dynamic XPath statements are generated without the required data validation.\n"
              },
              "help": {
                "text": "Perform input data validations on the server-side to avoid common injection attacks.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/021#details",
              "name": "XPath injection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "297",
              "fullDescription": {
                "text": "Dynamic SQL statements are generated without the required data validation and without using parameterized statements or stored procedures.\n"
              },
              "help": {
                "text": "Perform database queries by means of parameterized statements or stored procedures.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/297#details",
              "name": "SQL injection - Code",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "396",
              "fullDescription": {
                "text": "The automatic key rotation for the KMS service is disabled. By keeping static keys during long periods the chances to compromise a valid key are higher.\n"
              },
              "help": {
                "text": "Enable the automatic key rotation for all the service keys.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/396#details",
              "name": "Insecure service configuration - KMS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "152",
              "fullDescription": {
                "text": "The application uses the X-Frame Options header on the server responses as the only protection mechanism against clickjacking. This header is considered deprecated, since its protection can be bypassed using several iframe layers.\n"
              },
              "help": {
                "text": "- Disable the X-Frame Options from the server responses.\n- Define the frame_ancestors policy in the Content Security Policy header.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/152#details",
              "name": "Insecure or unset HTTP headers - X-Frame Options",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "358",
              "fullDescription": {
                "text": "DocumentBuilderFactory is insecurely configured, which makes it susceptible to XXE attacks.\n"
              },
              "help": {
                "text": "Securely configure DocumentBuilderFactory.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/358#details",
              "name": "Insecure service configuration - DocumentBuilderFactory",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "099",
              "fullDescription": {
                "text": "Some S3 buckets do not explicitly enable the Server-Side-Encryption (SSE) property. So the stored objects are not encrypted at rest, exposing their content to leaks by attackers or unauthorized users.\n"
              },
              "help": {
                "text": "Enable the SSE property in all S3 instances.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/099#details",
              "name": "Non-encrypted confidential information - S3 Server Side Encryption",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "125",
              "fullDescription": {
                "text": "The system displays the applications directories, allowing an attacker to know the content of the files stored on the server.\n"
              },
              "help": {
                "text": "- Disable the configurations of the server that allow to execute directory listing.\n- Establish index files that will be shown when the directories are loaded.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/125#details",
              "name": "Directory listing",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "128",
              "fullDescription": {
                "text": "The applications cookies are generated without properly setting the HttpOnly attribute.\n"
              },
              "help": {
                "text": "The application must set the HttpOnly attribute in the cookies with sensitive information.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/128#details",
              "name": "Insecurely generated cookies - HttpOnly",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "007",
              "fullDescription": {
                "text": "The applications configuration allows an attacker to trick authenticated users into executing actions without their consent.\n"
              },
              "help": {
                "text": "Use of tokens in forms to verify requests done by legitimate users.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/007#details",
              "name": "Cross-site request forgery",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "164",
              "fullDescription": {
                "text": "No requestValidationMode is assigned in the server configuration files, which would allow XSS attacks.\n"
              },
              "help": {
                "text": "Activate the recommended protection mechanisms as Request validation.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/164#details",
              "name": "Insecure service configuration",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "236",
              "fullDescription": {
                "text": "The .map files are exposed, making it easy for a malicious actor to analyze the application.\n"
              },
              "help": {
                "text": "Limit access of map files to authorized users and roles.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/236#details",
              "name": "Technical information leak - SourceMap",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "016",
              "fullDescription": {
                "text": "The server allows the usage of insecure TLS protocol versions.\n"
              },
              "help": {
                "text": "Update TLS protocol to version TLSv1.2 or TLSv1.3 if possible.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/016#details",
              "name": "Insecure encryption algorithm - SSL/TLS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "406",
              "fullDescription": {
                "text": "The AWS Elastic File System (EFS) service is encrypted with a default KMS key. Best practices recommend encrypting EFS instances using Customer Managed Keys (CMKs) to reduce risk of exposure and give full control of encrypted information.\n"
              },
              "help": {
                "text": "Enable the EFS encryption using a KMS Customer Managed Key (CMK)\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/406#details",
              "name": "Non-encrypted confidential information - EFS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "262",
              "fullDescription": {
                "text": "The server where the application is stored supports insecure ciphers - SHA1.\n"
              },
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/262#details",
              "name": "Insecure encryption algorithm - SHA1",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "407",
              "fullDescription": {
                "text": "One or more Elastic Block Store (EBS) instances are no encrypted, allowing an attacker to read potentially sensitive information regarding the launch configuration of EC2 Instances\n"
              },
              "help": {
                "text": "Enable the encryption of all the EBS instances by setting the property _Encrypted_ to _true_\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/407#details",
              "name": "Non-encrypted confidential information - EBS Volumes",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "309",
              "fullDescription": {
                "text": "The token used to consume the user creation service in the application is not generated securely, because the key that signs the token is weak and was easily found as indicated in the finding of weak credentials. For this reason, an attacker can modify token parameters such as the expiration date to consume the service, and perform queries in the application.\n"
              },
              "help": {
                "text": "Use strong passwords for signing and verification of the user creation token.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/309#details",
              "name": "Insecurely generated token - JWT",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "277",
              "fullDescription": {
                "text": "The AWS IAM (Identity and Access Management) policy has the Enable password expiration flag set to disable, good security practices suggest that credentials should be renewed in 90 day periods.\n"
              },
              "help": {
                "text": "- Establish credential policies following the requirements of the different security and cloud standards.\n- Credentials should have an expiration time limit to mitigate possible leakage.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/277#details",
              "name": "Weak credential policy - Password Expiration",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "354",
              "fullDescription": {
                "text": "There is no limit to the number of files that can be uploaded to the system per unit of time, and uploading a new one does not delete the previous one from the server.\n"
              },
              "help": {
                "text": "Delete previous avatar files when uploading a new one, apply throttling.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/354#details",
              "name": "Insecure file upload - Files Limit",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "129",
              "fullDescription": {
                "text": "The applications cookies are generated without properly setting the SameSite attribute.\n"
              },
              "help": {
                "text": "The application must set the SameSite attribute in the cookies with sensitive information.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/129#details",
              "name": "Insecurely generated cookies - SameSite",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "281",
              "fullDescription": {
                "text": "Insecure communications medium and channels require application data protection in transit.\n"
              },
              "help": {
                "text": "- Enable secure cipher suites and encryption protocols.\n- Encryption and data integrity authentication are important for protecting the communications channel.\n- It is equally important to authenticate the identity of the remote end of the connection.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/281#details",
              "name": "Use of an insecure channel - Cloud Infrastructure",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "400",
              "fullDescription": {
                "text": "Some AWS services (Such as EC2, ELB or S3) do not correctly set the logging property, which avoids the recording of log files. These files are useful to identify and trace malicious actions or anomalous behaviors. Alternatively, the log files do not have enough detail level.\n"
              },
              "help": {
                "text": "Set the logging property in AWS instances that could handle important data.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/400#details",
              "name": "Traceability Loss - AWS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "056",
              "fullDescription": {
                "text": "Due to an improper configuration of the server (e.g., an FTP service with username: anonymous and password: guest or an SMTP open relay), it is possible to make anonymous connections to it and access otherwise protected resources.\n"
              },
              "help": {
                "text": "Configure the services to avoid services enumeration or to connect to these anonymously.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/056#details",
              "name": "Anonymous connection",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "031",
              "fullDescription": {
                "text": "The application, a user or a role have more privileges than they require. This can be leveraged by an attacker to execute normally restricted actions on a system.\n"
              },
              "help": {
                "text": "Explicitly assign permissions to the appropriate groups and roles following the principle of least privilege.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/031#details",
              "name": "Excessive privileges - AWS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "392",
              "fullDescription": {
                "text": "The firewall security verifications either do not exist or can be bypassed.\n"
              },
              "help": {
                "text": "Guarantee that firewall security mechanisms and access rules are active and cannot be bypassed.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/392#details",
              "name": "Security controls bypass or absence - Firewall",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "267",
              "fullDescription": {
                "text": "Kubernetes default configuration is overly permissive, allowing users to escalate privileges or execute commands as privileged users.\n"
              },
              "help": {
                "text": "Set strict security policy disabling potentially harmful actions and restricting the user permissions.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/267#details",
              "name": "Excessive Privileges - Kubernetes",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "403",
              "fullDescription": {
                "text": "The application has android:usesCleartextTraffic set to true, which allows it to access resources that do not use encryption, a situation that could be exploited by an attacker to perform MitM attacks and compromise the confidentiality and integrity of the application.\n"
              },
              "help": {
                "text": "The android:usesCleartextTraffic must be set to false.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/403#details",
              "name": "Insecure service configuration - usesCleartextTraffic",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "153",
              "fullDescription": {
                "text": "The application does not set the Accept header or allows any MIME type in the requests. An attacker could abuse this feature to cause unexpected behaviors when the application interprets incorrect content-types.\n"
              },
              "help": {
                "text": "- Set the Accept Header in client requests.\n- Define explicitly the allowed content types for the application.\n- Deny all request that contain a content type different from the expected by the application.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/153#details",
              "name": "Insecure or unset HTTP headers - Accept",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "371",
              "fullDescription": {
                "text": "The web application generates dynamic web content from the client side without validating the origin of the potentially malicious data.\n"
              },
              "help": {
                "text": "Perform server-side and client-side input data validation to avoid the most common script injection attacks.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/371#details",
              "name": "DOM-Based cross-site scripting (XSS)",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "034",
              "fullDescription": {
                "text": "The system uses insecure functions, insufficient ranges or low-entropy components to generate random numbers. This could allow an attacker to guess the generation sequence after a short time or predict results using probabilistic methods.\n"
              },
              "help": {
                "text": "Use the most secure mechanisms offered by language to generate random numbers.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/034#details",
              "name": "Insecure generation of random numbers",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "418",
              "fullDescription": {
                "text": "Using the ADD command to automatically extract files to the destination directory adds the risk of exploiting vulnerabilities such as zip bombs and Zip Slip that could then be activated automatically.\n"
              },
              "help": {
                "text": "Avoid the use of the ADD command unless you need extract a local tar file. Instead, use the COPY command\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/418#details",
              "name": "Insecure service configuration - Docker",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "350",
              "fullDescription": {
                "text": "Due to improper implementation of the TrustManager checkServerTrusted method, methods are created that do not throw a certificate exception when invalid certificates are detected. Thanks to this it is possible to accept any incoming certificate and materialize Man in The Middle attacks.\n"
              },
              "help": {
                "text": "Define a processing logic for invalid certificates that includes rejecting the connection to such certificates and storing the technical details of the event in logs.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/350#details",
              "name": "Insecure digital certificates - Chain of trust",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "380",
              "fullDescription": {
                "text": "Docker dependencies are not pinned to an exact digest, making the Docker build unable the verify the integrity of the image and allowing a malicious actor to override the used components with malicious components without leaving a trace.\n"
              },
              "help": {
                "text": "Use mechanisms such as git-commits, or artifacts and hashes to verify the data integrity.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/380#details",
              "name": "Supply Chain Attack - Docker",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "423",
              "fullDescription": {
                "text": "The J2EE application use System.exit(), it is undesirable for a web application to attempt to shut down the application container.  Accessing a function that can shut down the application is an avenue for denial of service (DoS) attacks.\n"
              },
              "help": {
                "text": "Delegate shutdown functions only to privileged and duly authorized accesses.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/423#details",
              "name": "Inappropriate coding practices - System exit",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "188",
              "fullDescription": {
                "text": "The application allows the creation of dynamic DOM (Document Object Model) elements from user controlled inputs. In addition to being functionally expensive, this operation can lead to the creation and exploitation of other vulnerabilities such as buffer overflow or memory corruption.\n"
              },
              "help": {
                "text": "Avoid generating dynamic DOM from user controlled inputs\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/188#details",
              "name": "Lack of data validation - Modify DOM Elements",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "097",
              "fullDescription": {
                "text": "The system allows the introduction of a link to an external site controlled by a malicious actor. This site can then redirect the user to a different site in the original tab, making it look like a legitimate redirect performed by the system.\n"
              },
              "help": {
                "text": "Set the attribute rel with the noopener and noreferrer value in each external link.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/097#details",
              "name": "Reverse tabnabbing",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "036",
              "fullDescription": {
                "text": "The state information of application forms that is stored in the ViewState is not encrypted.\n"
              },
              "help": {
                "text": "Encrypt the ViewState in the application configuration.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/036#details",
              "name": "ViewState not encrypted",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "017",
              "fullDescription": {
                "text": "The system sends sensitive information through a channel or method which does not guarantee its confidentiality or integrity.\n"
              },
              "help": {
                "text": "Guarantee that credentials be sent through a more secure channel, such as session variables or using HTTP POST method.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/017#details",
              "name": "Sensitive information sent insecurely",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "169",
              "fullDescription": {
                "text": "The source code repository stores cipher keys directly. Allowing an attacker with access to the source code to compromise the keys to impersonate the application or decrypt the communications between server and client.\n"
              },
              "help": {
                "text": "Store the cipher keys in a secured Keystore.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/169#details",
              "name": "Insecure service configuration - Keys",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "131",
              "fullDescription": {
                "text": "The server is missing the Strict-Transport-Security HTTP header. Alternatively, the headers max-age is too short.\n"
              },
              "help": {
                "text": "Set the Strict-Transport-Security header with a max-age 63072000 and the includeSubDomains\n directive on all server responses.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/131#details",
              "name": "Insecure or unset HTTP headers - Strict Transport Security",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "402",
              "fullDescription": {
                "text": "The Azure configurations do not enable the log service with enough granularity. Omitting relevant information may hinder the detection of anomalous behaviors or security breaches.\n"
              },
              "help": {
                "text": "Configure the logs with the necessary granularity level to detect and identify potentially harmful behaviors by enabling logging for read, write and delete requests.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/402#details",
              "name": "Traceability Loss - Azure",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "044",
              "fullDescription": {
                "text": "HTTP methods such as TRACE, PUT and DELETE are enabled on the server. These methods may allow an attacker to include and/or delete files, or perform cross-site tracing attacks.\n"
              },
              "help": {
                "text": "Configure secure methods for servers requests.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/044#details",
              "name": "Insecure HTTP methods enabled",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "320",
              "fullDescription": {
                "text": "Internal service information should not be stored in the source code, especially AD configurations, as it is obtained from the admon-chanel configuration file.\n"
              },
              "help": {
                "text": "Service configurations and credentials must be in protected environments.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/320#details",
              "name": "Insecure service configuration - LDAP",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "120",
              "fullDescription": {
                "text": "The application does not make explicit the whole dependency tree it requires (direct and indirect third-party libraries) and their respective version.\n"
              },
              "help": {
                "text": "All dependencies must be declared with a specific version and must be referenced with a dependency manager (npm, pip, maven). This allows to standardize the projects construction and packaging.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/120#details",
              "name": "Improper dependency pinning",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "265",
              "fullDescription": {
                "text": "The source code uses RSA/ECB/PKCS1Padding and AES/CBC/PKCS5PADDING encryption and other references use CTR or CFB which are considered insecure.\n"
              },
              "help": {
                "text": "Only secure encryption with secure algorithms such as RSA/NONE/OAEPwithSHA-256andMGF1Padding or use implementations with the GCM mode encryption algorithm.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/265#details",
              "name": "Insecure encryption algorithm - AES",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "123",
              "fullDescription": {
                "text": "The application allows to read or execute files located on the server through relative paths manipulation in the input fields.\n"
              },
              "help": {
                "text": "- Validate that the parameters received by the application do not contain relative paths.\n- Disable insecure functions that allow reading of arbitrary files on the server.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/123#details",
              "name": "Local file inclusion",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "344",
              "fullDescription": {
                "text": "The system constructs system commands using inputs that can be manipulated externally, it does not correctly neutralize special elements that could modify the system command.\n"
              },
              "help": {
                "text": "Use whitelists or identifiers that are then transformed into static inputs to Call() calls.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/344#details",
              "name": "Lack of data validation - Non Sanitized Variables",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "030",
              "fullDescription": {
                "text": "The system sends sensitive information via URL parameters using the GET method. These parameters are:\n- Stored in clear text in the browser history.\n- Sent to external sites via the referrer HTTP header.\n- Sent to external sites via the search bar if the browser interprets the URL as a query.\n- Visible to scripts running on the browser that may belong to third-parties.\n"
              },
              "help": {
                "text": "Guarantee that the sessions ID are sent through secure methods (POST) or obtain the cookies session.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/030#details",
              "name": "Sensitive information sent via URL parameters",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "100",
              "fullDescription": {
                "text": "It is possible to induce the application's server into making requests to an arbitrary domain.\n"
              },
              "help": {
                "text": "The system must avoid that the information query from the server be controlled by users. If this is necessary, the system must restrict the endpoints accepted for query.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/100#details",
              "name": "Server-side request forgery (SSRF)",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "005",
              "fullDescription": {
                "text": "Due to an insecure role configuration, it is possible to obtain administrative access or privileges using a standard user account.\n"
              },
              "help": {
                "text": "The roles must be controlled with users tokens or the exposure of user ID must be avoided.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/005#details",
              "name": "Privilege escalation",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "158",
              "fullDescription": {
                "text": "Azure Active Directory Graph API services can be accessed and used from anywhere on the Internet. Note: the URL of the service as well as the credentials to use it were found in the application code.\n"
              },
              "help": {
                "text": "Verify Azure documentation regarding Conditional Access policy and securely configure the service by establishing trusted locations to access the service.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/158#details",
              "name": "Unrestricted access between network segments - Azure AD",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "200",
              "fullDescription": {
                "text": "Some features of the application do not properly keep track of errors, exceptional events or critical actions on the system, hidering the detection of possible security events.\n"
              },
              "help": {
                "text": "Set alerts for errors, events and critical actions using the mechanisms available by the technology stack.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/200#details",
              "name": "Traceability loss",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "183",
              "fullDescription": {
                "text": "The system has the debug mode active which generates an information leak when an error is generated.\n"
              },
              "help": {
                "text": "Make sure that debugging mode is not enabled in the production environment and remove statements or portions of code that are executing in debugging mode.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/183#details",
              "name": "Debugging enabled in production",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "381",
              "fullDescription": {
                "text": "Terraform dependencies are not pinned, allowing a malicious actor to override the used components with malicious components without leaving a trace.\n"
              },
              "help": {
                "text": "Use mechanisms such as git-commits, or artifacts and hashes to verify the data integrity.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/381#details",
              "name": "Supply Chain Attack - Terraform",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "079",
              "fullDescription": {
                "text": "Dependencies are not explicitly declared (name and version) within the source code. They are copied directly into the repositories.\n"
              },
              "help": {
                "text": "All dependencies must be declared and must referenced with a dependency manager (npm, pip, maven). This allows to standardize projects construction and packaging.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/079#details",
              "name": "Non-upgradable dependencies",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "024",
              "fullDescription": {
                "text": "The infrastructure definition for network segments in the AWS context is too permissive.\n"
              },
              "help": {
                "text": "Limit network segments, ports, IP addresses, network protocols, and administrative services only to the required users.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/024#details",
              "name": "Unrestricted access between network segments - AWS",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "117",
              "fullDescription": {
                "text": "Files are stored in the repository that cannot be verified because their content is not compatible with their extension.\n"
              },
              "help": {
                "text": "- Remove the files that should not be versioned from the repository.\n- Include the affected extensions in the .gitignore file.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/117#details",
              "name": "Unverifiable files",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "103",
              "fullDescription": {
                "text": "The APK is not digitally signed.\n"
              },
              "help": {
                "text": "Digitally sign the APK.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/103#details",
              "name": "Insufficient data authenticity validation - APK signing",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "335",
              "fullDescription": {
                "text": "The native S3 VersioningConfiguration resource, which allows to preserve, recover and restore each version of each object stored in the Buckets due to causes such as malicious actions of users or application failures, is not enabled.\n"
              },
              "help": {
                "text": "Securely configure the Buckets by enabling the VersioningConfiguration resource.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/335#details",
              "name": "Insecure service configuration - Bucket",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "037",
              "fullDescription": {
                "text": "It is possible to obtain technical information such as:\n- System component versions (HTTP headers, service banner, etc.)\n- Specific information about the configuration of server components (php.ini, web.config)\n"
              },
              "help": {
                "text": "- Eliminate the services banner with information leakage.\n- Verify that HTTP headers do not display any name or version.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/037#details",
              "name": "Technical information leak",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "332",
              "fullDescription": {
                "text": "Customer information is transmitted over a channel that does not use encryption.\n"
              },
              "help": {
                "text": "Deploy the application over an encrypted communication channel, e.g. HTTPS using TLS.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/332#details",
              "name": "Use of insecure channel - Source code",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "035",
              "fullDescription": {
                "text": "The systems credential policy is not compliant with security regulations.\n"
              },
              "help": {
                "text": "Establish a policy for creation of credentials that uses phrases, not word based passwords.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/035#details",
              "name": "Weak credential policy",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "226",
              "fullDescription": {
                "text": "Real user information such as real ID numbers and phone numbers are being stored in the source code.\n"
              },
              "help": {
                "text": "Personal information should not be exposed in the source code, and in case it is necessary, the data used should not correspond to reality.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/226#details",
              "name": "Business information leak - Personal Information",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "015",
              "fullDescription": {
                "text": "The server uses Basic authentication over an insecure channel.\n"
              },
              "help": {
                "text": "Use stronger authentication mechanisms like Bearer and OAuth.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/015#details",
              "name": "Insecure authentication method - Basic",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "446",
              "fullDescription": {
                "text": "An insecure configuration of the Azure service can cause an impact on the service.\n"
              },
              "help": {
                "text": "Configure as securely as possible the service.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/446#details",
              "name": "Insecure service configuration - Azure",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "385",
              "fullDescription": {
                "text": "Confidential information is stored in plain text allowing an attacker to view it without any encryption.\n"
              },
              "help": {
                "text": "Encrypt all sensitive information that is transported or stored within the application according to the organizations policies.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/385#details",
              "name": "Non-encrypted confidential information - Keys",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "055",
              "fullDescription": {
                "text": "The application allows backups via ADB (Android Debug Bridge). The backups performed by this functionality are not encrypted. Sensitive data of authenticated users can be included in the backup, and this data can be extracted by a non-authenticated attacker. Additionally, data can be copied into a USB stick and be moved out of the sphere of control of the application.\n"
              },
              "help": {
                "text": "Configure the attribute: application.android:allowBackup to false in the file: AndroidManifest.xml.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/055#details",
              "name": "Insecure service configuration - ADB Backups",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "098",
              "fullDescription": {
                "text": "It is possible to modify the path to which an uploaded file will be saved.\n"
              },
              "help": {
                "text": "Validate uploaded files names on the system and restrict the storage to destined folders only.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/098#details",
              "name": "External control of file name or path",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "363",
              "fullDescription": {
                "text": "The credential policy present in the system does not have the recommended parameters.\n"
              },
              "help": {
                "text": "Establish a policy for credential creation that involves phrases and not word-based passwords.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/363#details",
              "name": "Weak credential policy - Password strength",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "405",
              "fullDescription": {
                "text": "The system files or directories have an access mode too permissive\n"
              },
              "help": {
                "text": "System files and directories must be restricted by a custom permission mask, for example an access mode 0600\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/405#details",
              "name": "Excessive privileges - Access Mode",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "280",
              "fullDescription": {
                "text": "The cookie session doesn't change after a valid login which allow an attacker to hijack the user session by setting the user cookie for one known by the attacker.\n"
              },
              "help": {
                "text": "Invalidate the anonymous cookie and create a new one after a successful login.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/280#details",
              "name": "Session Fixation",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "052",
              "fullDescription": {
                "text": "The application uses insecure encryption algorithms.\n"
              },
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/052#details",
              "name": "Insecure encryption algorithm",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "313",
              "fullDescription": {
                "text": "Due to a misconfiguration of X.509 certificates, the application can accept invalid certificates, making it possible to carry out Man in The Middle attacks.\n"
              },
              "help": {
                "text": "Throw typed exceptions in case of detection of invalid certificates.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/313#details",
              "name": "Insecure service configuration - Certificates",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "078",
              "fullDescription": {
                "text": "It is possible to crack the token's hash and obtain the information it is masking because it is not generated using a secure cryptographic mechanism.\n"
              },
              "help": {
                "text": "Generate a token with random components without sensitive information.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/078#details",
              "name": "Insecurely generated token",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "412",
              "fullDescription": {
                "text": "Some Azure Key Vaults instances do not enable properties that allow secrets to be recovered in the event of accidental deletion or by malicious actors.\n"
              },
              "help": {
                "text": "Enable the properties EnableSoftDelete and EnablePurgeProtection in every Azure Key Vault (AKV) instance.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/412#details",
              "name": "Lack of protection against deletion - Azure Key Vault",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "157",
              "fullDescription": {
                "text": "The current network configuration lacks access restrictions between network segments, which would allow an attacker to access privileged server segments or services from unauthorized networks.\n"
              },
              "help": {
                "text": "Segment the corporate network using the principle of least privilege necessary to limit access to the database.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/157#details",
              "name": "Unrestricted access between network segments",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "133",
              "fullDescription": {
                "text": "The application uses cipher algorithms that expose all messages made during the communication if the current private key is compromised.\n"
              },
              "help": {
                "text": "Enable Perfect-Forward-Secrecy in the server side, by allowing Ciphersuites that contain DHE and ECDHE on its names.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/133#details",
              "name": "Insecure encryption algorithm - Perfect Forward Secrecy",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "004",
              "fullDescription": {
                "text": "The system builds OS commands using inputs that can be manipulated externally, it does not correctly neutralize special elements that could modify the OS command.\n"
              },
              "help": {
                "text": "- If at all possible, use standard library calls rather than external processes to recreate the desired functionality.\n- Keep as much data as possible used to generate command outside of external control.\n- Properly escape the arguments used to generate the command and avoid special characters.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/004#details",
              "name": "Remote command execution",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "094",
              "fullDescription": {
                "text": "The application uses algorithms with insecure cipher block chaining.\n"
              },
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/094#details",
              "name": "Insecure encryption algorithm - Cipher Block Chaining",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "401",
              "fullDescription": {
                "text": "The secrets stored in Azure Key Vault do not set an expiration date.\n"
              },
              "help": {
                "text": "Define an expiration date for Azure secrets by setting the expiration_date property.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/401#details",
              "name": "Insecure service configuration - AKV Secret Expiration",
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "071",
              "fullDescription": {
                "text": "The server is missing the Referrer-Policy HTTP header. Alternatively, the headers configuration is unsafe.\n"
              },
              "help": {
                "text": "Set the Referrer-Policy header to no-referrer, same-origin, strict-origin, or strict-origin-when-cross-origin in the server responses.\n"
              },
              "helpUri": "https://docs.fluidattacks.com/criteria/vulnerabilities/071#details",
              "name": "Insecure or unset HTTP headers - Referrer-Policy",
              "properties": {
                "auto_approve": true
              }
            }
          ],
          "semanticVersion": "1.0.0",
          "version": "1.0.0"
        }
      },
      "newlineSequences": [
        "\r\n",
        "\n"
      ],
