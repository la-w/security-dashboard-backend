          ],
          "properties": {
            "cwe_ids": [
              "CWE-693"
            ],
            "cvss": "CVSS:3.1/AV:N/AC:H/PR:L/UI:R/S:U/C:N/I:L/A:N/E:U/RL:O/RC:R",
            "cvss_v4": "CVSS:4.0/AV:N/AC:H/AT:N/PR:L/UI:P/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N/E:U",
            "kind": "SAST",
            "vulnerability_type": "LINES",
            "method_developer": "ugomez@fluidattacks.com",
            "source_method": "github_actions.github_actions_without_hash",
            "auto_approve": false,
